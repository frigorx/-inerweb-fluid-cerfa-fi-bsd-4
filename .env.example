# ============================================================
# inerWeb Fluide v8 — modèle de configuration
# ============================================================
# Copiez ce fichier en « .env » puis remplissez les valeurs.
# Le fichier .env est ignoré par git : il ne quitte jamais
# votre machine. NE METTEZ AUCUN SECRET dans .env.example.
# ============================================================

# ----- Mode de fonctionnement -----
# demo  : données fictives, aucune donnée réelle (vitrine, bac à sable)
# local : serveur Node.js sur ce poste, base SQLite dans data/ (recommandé lycée)
# cloud : base Supabase partagée (multi-postes) — voir INSTALLATION_CLOUD.md
MODE=local

# ----- Port d'écoute du serveur local -----
# L'application sera accessible sur http://localhost:2011
PORT=2011

# ----- Mode cloud UNIQUEMENT (laisser vide sinon) -----
# Valeurs fournies par votre projet Supabase — voir INSTALLATION_CLOUD.md
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ----- Sauvegardes -----
# Sauvegarde automatique de la base et des documents (true / false)
SAUVEGARDE_AUTO=true
# Chiffrement des sauvegardes ZIP par phrase de passe (AES-256-GCM).
# Si true, la phrase de passe sera demandée dans l'application.
SAUVEGARDE_CHIFFREE=false
